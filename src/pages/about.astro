---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import headshot from '../assets/images/headshot.jpg';
---

<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description="DevRel Engineer, AI developer tools, adventurer." />
  </head>
  <body>
    <Header />
    <main>

      <div class="profile">
        <Image src={headshot} alt="Brian McFadden" class="headshot" />
        <div class="profile-info">
          <h1 class="name">Brian McFadden</h1>
          <h2 class="role">DevRel Engineer | AI Developer Tools</h2>
          <div class="meta">
            <span>Canada</span>
            <span class="dot">·</span>
            <a class="org-link" href="https://edgeimpulse.com" target="_blank" rel="noopener noreferrer">Edge Impulse</a>
            <span class="dot">·</span>
            <a class="social-icon" href="https://github.com/bmcfads" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" fill="currentColor"/></svg>
            </a>
            <a class="social-icon" href="https://linkedin.com/in/bmcfads" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="currentColor"/></svg>
            </a>
            <a class="social-icon" href="https://youtube.com/@bmcfads" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/></svg>
            </a>
            <span class="dot">·</span>
            <span>😎 🤙🏻</span>
          </div>
        </div>
      </div>

      <p class="bio">
				I explore for a living: turning ambiguous ideas into real things professionally, chasing mountains, ultras, and new experiences in my off time. I'm drawn to problems where the brief is essentially "figure out if this works" and fuelled by people telling me it's not possible.
			</p>

      <hr />

      <div class="facts-grid">
				<div class="fact-card">
          <span class="fact-emoji">⛵</span>
          <p>Lived on a sailboat for a year</p>
        </div>
        <div class="fact-card">
          <span class="fact-emoji">🏔️</span>
          <p>Everested the Grouse Grind</p>
        </div>
				<div class="fact-card">
          <span class="fact-emoji">🐶</span>
          <p>Dog dad to Shelby</p>
        </div>
        <div class="fact-card">
          <span class="fact-emoji">🎓</span>
          <p>Dropped out of grad school, twice.</p>
        </div>
				<div class="fact-card">
          <span class="fact-emoji">🌍</span>
          <p>Traveled to 40+ countries</p>
        </div>
        <div class="fact-card">
          <span class="fact-emoji">🏃</span>
          <p>Ran a backyard ultra</p>
        </div>
      </div>

    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .profile {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .headshot {
    flex-shrink: 0;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border) !important;
    padding: 3px;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .name {
    margin: 0;
    font-size: 3rem;
  }

  .role {
    margin: 0;
    font-family: var(--font-barlow), sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .meta {
    margin: 0;
    font-size: 1rem;
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

	.org-link {
		color: var(--fg-muted) !important;
		text-decoration: none;
		transition: color 0.2s;
	}

	.org-link:hover {
		color: var(--fg) !important;
	}

  .social-icon {
    color: var(--fg-muted) !important;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .social-icon:hover {
    color: var(--fg) !important;
  }

  .dot {
    opacity: 0.4;
  }

  .bio {
    margin-bottom: 2.5rem;
    line-height: 1.8;
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    width: 100%;
  }

  .fact-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .fact-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  .fact-card p {
    margin: 0;
    font-family: var(--font-barlow), sans-serif;
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    main {
      padding: 1.5rem 1rem;
      width: 100%;
    }

    .profile {
      flex-direction: column;
      align-items: center;
      text-align: center;
			gap: 1rem;
    }

    .name {
      font-size: 2rem;
    }

    .meta {
      justify-content: center;
    }

    .bio {
      width: 100%;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .facts-grid {
      grid-template-columns: 1fr;
      width: 100%;
    }
  }
</style>
