---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_TITLE } from '../consts';
import headshot from '../assets/images/headshot.jpg';
---

<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description="DevRel Engineer, AI developer tools, adventurer." />
  </head>
  <body>
    <Header />
    <main>

      <div class="profile">
        <Image src={headshot} alt="Brian McFadden" class="headshot" />
        <div class="profile-info">
          <h1 class="name">Brian McFadden</h1>
          <h2 class="role">DevRel Engineer | AI Developer Tools</h2>
          <div class="meta">
            <span>Canada</span>
            <span class="dot">·</span>
            <a class="org-link" href="https://edgeimpulse.com" target="_blank" rel="noopener noreferrer">Edge Impulse</a>
            <span class="dot">·</span>
            <SocialLinks size={16} />
            <span class="dot">·</span>
            <span>😎 🤙🏻</span>
          </div>
        </div>
      </div>

      <p class="bio">
				I explore for a living: turning ambiguous ideas into real things professionally, chasing mountains, ultras, and new experiences in my off time. I'm drawn to problems where the brief is essentially "figure out if this works" and fuelled by people telling me it's not possible.
			</p>

      <hr />

      <div class="facts-grid">
				<div class="fact-card">
          <span class="fact-emoji">⛵</span>
          <p>Lived on a sailboat for a year</p>
        </div>
        <div class="fact-card">
          <span class="fact-emoji">🏔️</span>
          <p>Everested the Grouse Grind</p>
        </div>
				<div class="fact-card">
          <span class="fact-emoji">🐶</span>
          <p>Dog dad to Shelby</p>
        </div>
        <div class="fact-card">
          <span class="fact-emoji">🎓</span>
          <p>Dropped out of grad school, twice.</p>
        </div>
				<div class="fact-card">
          <span class="fact-emoji">🌍</span>
          <p>Traveled to 40+ countries</p>
        </div>
        <div class="fact-card">
          <span class="fact-emoji">🏃</span>
          <p>Ran a backyard ultra</p>
        </div>
      </div>

    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .profile {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .headshot {
    flex-shrink: 0;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border) !important;
    padding: 3px;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .name {
    margin: 0;
    font-size: 3rem;
  }

  .role {
    margin: 0;
    font-family: var(--font-barlow), sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
  }

  .meta {
    margin: 0;
    font-size: 1rem;
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

	.org-link {
		color: var(--fg-muted) !important;
		text-decoration: none;
		transition: color 0.2s;
	}

	.org-link:hover {
		color: var(--fg) !important;
	}

  .dot {
    opacity: 0.4;
  }

  .bio {
    margin-bottom: 2.5rem;
    line-height: 1.8;
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    width: 100%;
  }

  .fact-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .fact-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  .fact-card p {
    margin: 0;
    font-family: var(--font-barlow), sans-serif;
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    main {
      padding: 1.5rem 1rem;
      width: 100%;
    }

    .profile {
      flex-direction: column;
      align-items: center;
      text-align: center;
			gap: 1rem;
    }

    .name {
      font-size: 2rem;
    }

    .meta {
      justify-content: center;
    }

    .bio {
      width: 100%;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .facts-grid {
      grid-template-columns: 1fr;
      width: 100%;
    }
  }
</style>
