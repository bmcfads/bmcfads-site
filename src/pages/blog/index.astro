---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPosts = allPosts.filter((post) => post.data.featured);
const latestPosts = allPosts.filter((post) => !post.data.featured);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>

      {featuredPosts.length > 0 && (
        <section class="post-section">
          <h2 class="section-label">Featured</h2>
          <ul class="post-list">
            {featuredPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <div class="post-info">
                    <div class="post-top">
                      <span class="post-title">{post.data.title}</span>
                      <span class="post-date">
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                    </div>
                    <span class="post-desc">{post.data.description}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="post-section">
        <h2 class="section-label">Latest</h2>
        <ul class="post-list">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <div class="post-info">
                  <div class="post-top">
                    <span class="post-title">{post.data.title}</span>
                    <span class="post-date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                  </div>
                  <span class="post-desc">{post.data.description}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .post-section {
    margin-bottom: 3rem;
  }

  .section-label {
    margin: 0 0 0.75rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .post-list li:first-child {
    border-top: 1px solid var(--border);
  }

  .post-list a {
    display: flex;
    align-items: flex-start;
    padding: 0.875rem 0.5rem;
    color: var(--fg);
    text-decoration: none;
    transition: background 0.15s;
  }

  .post-list a:hover {
    background: rgba(255, 255, 255, 0.04);
  }

	.post-list a:hover .post-title {
		color: var(--accent);
	}

  .post-info {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

  .post-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .post-title {
		font-family: var(--font-barlow), sans-serif;
		font-weight: 800;
		font-size: 1rem;
		color: var(--fg);
		flex: 1;
		transition: color 0.15s;
	}

  .post-date {
    font-size: 0.8rem;
    color: var(--fg-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
</style>
