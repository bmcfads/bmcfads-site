---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import SocialLinks from '../components/SocialLinks.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import logo from '../assets/brand/bmcfads-logo-white.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>

    <aside class="socials">
			<SocialLinks size={20} class="vertical" />
    </aside>

    <main class="home">
      <Image
        src={logo}
        alt="BMCFADS"
        class="logo"
      />
      <Nav />
      <TerminalPrompt />
    </main>

  </body>
</html>

<style>
  body {
    height: 100vh;
    overflow: hidden;
  }

  .socials {
		position: fixed;
		left: 2rem;
		top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		z-index: 10;
	}

  .home {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .logo {
    width: 75%;
    max-width: 500px;
    height: auto;
  }

  .pipe {
    color: var(--fg);
    opacity: 0.3;
  }

  :global(.vertical) {
    flex-direction: column;
  }
</style>
