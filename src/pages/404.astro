---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="404 — Lost" description="This page doesn't exist." />
  </head>
  <body>
    <Header />
    <main>
      <h1>404</h1>
      <h2>Looks like you've gone off trail.</h2>
      <p class="url">The page <code>{Astro.url.pathname}</code> doesn't exist.</p>
      <p>Head back to <a href="/">home</a>, check out the <a href="/blog">blog</a>, or see what I've been <a href="/portfolio">building</a>.</p>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    gap: 1rem;
  }

  h1 {
    font-size: 5rem;
    margin: 0;
    color: var(--accent);
    line-height: 1;
  }

  .url {
    margin: 0;
  }
</style>
