---
const pathname = Astro.url.pathname;
const path = pathname === '/' ? '~' : '~' + pathname.replace(/\/$/, '');
---

<div class="terminal-prompt">
  <span class="host">bmcfads</span>
  <span class="separator">: </span>
  <span class="path">{path} </span>
  <span class="prompt">$ </span>
  <span class="cursor">▋</span>
</div>

<style>
  .terminal-prompt {
    font-family: monospace;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    white-space: pre;
  }

  .host {
    color: var(--accent);
  }

  .separator {
    color: var(--accent);
  }

  .path {
    color: var(--accent);
  }

  .prompt {
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
