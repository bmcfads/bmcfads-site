---
import SocialLinks from './SocialLinks.astro';
import TerminalPrompt from './TerminalPrompt.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<footer>
  <TerminalPrompt />
  <p class="description">{SITE_DESCRIPTION}</p>
  <p class="copyright">&copy; {new Date().getFullYear()} Brian McFadden. All rights reserved.</p>
  <SocialLinks size={18} />
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .description {
    font-family: var(--font-barlow), sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg);
    margin: 0;
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin: 0;
  }
</style>
